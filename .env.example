# Copy to .env and adjust. Never commit .env. Values here are placeholders or the code defaults.
# Docker Compose reads .env for interpolation. Only the variables listed under each service in
# docker-compose.yml reach the containers; the others apply to local (non-Docker) runs only.
# See docs/CONFIGURATION.md for the full reference.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Paths (local runs; relative to repo root or absolute. Compose sets /app/... itself) ---
DATA_DIR=data
SOURCES_REGISTRY=config/sources.yaml

# --- Qdrant ---
# Local runs from the host: http://localhost:6343. Compose sets http://qdrant:6333 for the backend itself.
QDRANT_URL=http://localhost:6343
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=official_docs

# --- Ollama ---
# Ollama runs natively on the host (GPU).
OLLAMA_URL=http://127.0.0.1:11434
# URL used by the backend container to reach the host Ollama (docker-compose.yml default shown).
OLLAMA_URL_FOR_CONTAINERS=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
LLM_MODEL=mistral:latest
# Local runs only (the container uses the same code default): FR->EN translation of quoted checklist items.
TRANSLATION_MODEL=translategemma:4b
LLM_TIMEOUT_SECONDS=300
INTENT_LLM_FALLBACK=true
RETRIEVAL_MIN_SCORE=0.45

# --- Ingestion ---
# Identifies this project honestly to official websites.
HTTP_USER_AGENT=TunisianAdminAssistant-Research/0.1 (academic project; contact via repository)
HTTP_TIMEOUT_SECONDS=60
MAX_DOWNLOAD_BYTES=52428800
DEFAULT_CRAWL_DELAY_SECONDS=2

# --- Uploads (form analysis) ---
MAX_UPLOAD_BYTES=10485760

# --- n8n ---
# REQUIRED: n8n refuses to start without it. Use a long random string and keep it: it encrypts n8n credentials.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_HOST_PORT=5678
GENERIC_TIMEZONE=Africa/Tunis

# --- Host port mappings (6333 is avoided on purpose: another project may use it) ---
QDRANT_HOST_PORT=6343
BACKEND_HOST_PORT=8000

# --- Telegram ---
# Token from @BotFather. Only the telegram-bridge container reads it (compose profile "telegram").
TELEGRAM_BOT_TOKEN=
# Bridge -> n8n webhook for local runs. Inside Docker Compose it is http://n8n:5678/webhook/assistant
ASSISTANT_WEBHOOK_URL=http://localhost:5678/webhook/assistant

# --- Security (see docs/SECURITY_DEPLOYMENT_GUIDE.md and docs/SECURITY_PHASE2_ACTIVATION_PLAN.md) ---
# Empty ADMIN_API_KEY disables /ingestion/run and /index/run (HTTP 403). Set it only to run them, then send X-Admin-Key.
ADMIN_API_KEY=
# When set, /agents/* and /retrieve require X-Agent-Key: configure the n8n HTTP nodes first.
AGENT_API_KEY=
# When set, the Telegram bridge, web demo and CLI send X-Assistant-Key to the n8n assistant webhook.
ASSISTANT_WEBHOOK_KEY=

# --- Optional tuning (local runs only; defaults from backend/settings.py, not forwarded by docker-compose.yml) ---
# RETRIEVAL_MODE=hybrid
# RETRIEVAL_MAX_PER_DOC_RATIO=0.4
# EVIDENCE_VERIFICATION=true
# EVIDENCE_TOPIC_CHECK=false
# OCR_LANGUAGES=ara+fra
# MAX_REQUEST_BYTES=15728640
# PROMPTS_DIR=prompts
# EXTRA_CA_DIR=config/certs
